# Copy to .env and fill in. Never commit .env.
# cp .env.example .env

# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model used by WorkPilot. Alternatives: claude-opus-5-5 (more capable, 2x the price),
# claude-haiku-5-5 (much cheaper, fine for quick experiments).
WORKPILOT_MODEL=claude-sonnet-5-5
